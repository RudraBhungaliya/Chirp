# ==============================================================================
# Chirp Master Environment Variable Reference
# ==============================================================================
# Copy and populate the corresponding files:
#   Backend  -> server/.env
#   Frontend -> client/.env
# ==============================================================================

# --- BACKEND (server/.env) ---
# Port the backend server listens on (default: 5001)
PORT=5001

# Environment mode ('development' or 'production')
NODE_ENV=development

# MongoDB Connection String (Atlas URI or local Docker connection)
# Example Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/Chirp?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/chirp
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/Chirp?retryWrites=true&w=majority

# Secret key used for signing JWT authentication tokens
JWT_SECRET=your_high_entropy_jwt_secret_key_minimum_32_characters

# JWT token validity duration (e.g., 7d, 24h, 30d)
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Web Client ID (leave blank to use quick dev accounts)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Allowed CORS & WebSocket origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Maximum attachment upload size in MB (default: 50)
MAX_FILE_SIZE_MB=50

# --- FRONTEND (client/.env) ---
# Backend API URL
VITE_API_URL=http://localhost:5001

# Backend Socket.IO URL
VITE_SOCKET_URL=http://localhost:5001

# Google OAuth 2.0 Web Client ID (matches GOOGLE_CLIENT_ID in server)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

