# ==============================================================================
# Chirp Backend Environment Variables
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or local Docker)
# Local: mongodb://127.0.0.1:27017/chirp
# Atlas: mongodb+srv://<db_user>:<db_password>@cluster0.xxxx.mongodb.net/Chirp?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/Chirp?retryWrites=true&w=majority

# JWT Authentication Secret (Use a secure, random string in production)
# Generate via: openssl rand -base64 32
JWT_SECRET=chirp_dev_jwt_secret_key_minimum_32_chars_replace_in_prod
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Leave blank to use instant quick dev sign-in accounts (Alice / Bob)
GOOGLE_CLIENT_ID=

# CORS & WebSocket Allowed Origins (comma-separated list)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# File Upload Limits (in Megabytes)
MAX_FILE_SIZE_MB=50
